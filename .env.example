# Langchain4a -- Environment Variables
# Copy this file to .env and fill in your values.
# The .env file is gitignored (never commit secrets).

# =========================================
# OpenRouter provider
# =========================================

# Required: OpenRouter API key
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: override defaults
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=openai/gpt-3.5-turbo
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_MAX_TOKENS=1024

# OpenRouter-specific headers (used in Build_Extra_Headers)
OPENROUTER_SITE_URL=https://your-app.example.com
OPENROUTER_APP_NAME=YourAppName

# =========================================
# OpenAI provider (direct, not via OpenRouter)
# =========================================

# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
# OPENAI_MODEL=gpt-3.5-turbo
# OPENAI_TEMPERATURE=0.7
# OPENAI_MAX_TOKENS=1024

# =========================================
# Proxy settings (shared across providers)
# =========================================

# Proxy mode: "socks5" or leave empty for direct connection
# PROXY_MODE=socks5

# SOCKS5 proxy host (only used when PROXY_MODE=socks5)
# PROXY_HOST=127.0.0.1

# SOCKS5 proxy port
# PROXY_PORT=1080

# SOCKS5 proxy authentication (optional)
# PROXY_USER=your-proxy-username
# PROXY_PASS=your-proxy-password

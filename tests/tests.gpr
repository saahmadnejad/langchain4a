with "langchain4a";
with "aunit";

project Tests is

   for Source_Dirs use (".");
   for Object_Dir use "./obj";
   for Exec_Dir use "./bin";

   for Main use ("test_main.adb");

   package Compiler is
       for Default_Switches ("Ada") use ("-gnat2022", "-g", "-gnatwU");
   end Compiler;

end Tests;

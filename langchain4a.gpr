with "config/langchain4a_config";

project Langchain4a is

   for Source_Dirs use ("./src", "./src/core", "./src/chains",
                       "./src/memory", "./src/llm", "./src/net");

    for Object_Dir use "./obj";
    for Library_Dir use "./lib";
    for Library_Name use "langchain4a";
    for Library_Kind use "static";

    package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-g", "-gnatwU");
   end Compiler;

end Langchain4a;
